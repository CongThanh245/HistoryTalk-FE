# === Copy file này thành .env.local rồi sửa theo backend đang dùng ===

# --- Option 1: Spring Boot Backend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_PATH=/Historical-tell/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/Historical-tell
NEXT_PUBLIC_VOICE_USE_INTERNAL=false

# --- Option 2: Node.js Backend ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_PATH=/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
# NEXT_PUBLIC_VOICE_USE_INTERNAL=true

# Gemini API Key (optional)
GEMINI_API_KEY=
