# === Copy file này thành .env.local rồi sửa theo backend đang dùng ===

# --- Option 1: Spring Boot Backend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_PATH=/Historical-tell/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/Historical-tell
NEXT_PUBLIC_GOOGLE_AUTH_MODE=redirect
NEXT_PUBLIC_GOOGLE_OAUTH_START_URL=http://localhost:8080/Historical-tell/oauth2/authorization/google
NEXT_PUBLIC_VOICE_USE_INTERNAL=true
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Gemini API Key - BẮT BUỘC cho voice chat khi dùng internal route
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Voice Chat Mode ---
# Internal API routes:
#   /api/voice/stt     - Speech-to-Text riêng (hiển thị user text ngay)
#   /api/voice/stream  - Streaming TTS (phát audio từng câu, giảm latency)
#   /api/voice/chat    - Legacy (chờ full response)

# --- Option 2: Node.js Backend ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_PATH=/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
# NEXT_PUBLIC_GOOGLE_AUTH_MODE=id_token
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_VOICE_USE_INTERNAL=true
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Azure Speech TTS ---
# Server-side only. Do not prefix with NEXT_PUBLIC_.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
