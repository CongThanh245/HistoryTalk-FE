NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_PATH=/Historical-tell/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/Historical-tell

# ── Voice Chat Pipeline ────────────────────────────────────────────────────────
# Đặt true để dùng Next.js Route Handler (không cần BE team implement)
# Đặt false để gọi Spring Boot backend như bình thường
NEXT_PUBLIC_VOICE_USE_INTERNAL=true

# Gemini API Key — lấy tại https://aistudio.google.com/apikey
# ⚠️  KHÔNG có tiền tố NEXT_PUBLIC_ → server-only, không lộ ra browser
GEMINI_API_KEY=