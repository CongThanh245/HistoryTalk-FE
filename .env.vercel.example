# Confirmed production endpoints. Set these in Vercel > Settings > Environment Variables.
# Scope: Production. These are public values, not credentials.
NEXT_PUBLIC_SITE_URL=https://historytalk.online
NEXT_PUBLIC_API_BASE_URL=https://historytalk.app
NEXT_PUBLIC_API_BASE_PATH=/Historical-tell/api/v1

# TODO: real Search Console / Bing verification values, if using HTML verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# TODO: actual public-content revision date in ISO 8601. Leave blank if unknown.
SEO_CONTENT_UPDATED_AT=

# Keep existing payment, OAuth, WebSocket and voice settings in Vercel.
# Rebuild the updated source after applying NEXT_PUBLIC_* values.
